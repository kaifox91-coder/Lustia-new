# Local developer API key — copy this file to secrets.properties and fill in your key.
# secrets.properties is git-ignored and must never be committed.
# Get a free key at: https://aistudio.google.com/app/apikey
#
# The Gradle property name is geminiApiKey (camelCase).
# Alternatively, add the same line to ~/.gradle/gradle.properties for a machine-wide default.
geminiApiKey=AIzaSy_YOUR_ACTUAL_KEY_HERE
